# Nova Studio Next — приклад для нових вкладок, автодоповнення і помилок
function sum_to(limit)
    let total = 0
    let number = 1
    while number <= limit
        total = total + number
        number = number + 1
    end
    return total
end

show "Nova Studio Next — Update 14"
show "Сума чисел від 1 до 10: " + str(sum_to(10))
